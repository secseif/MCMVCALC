# ---- Supabase (auth + banco de dados) ----
# Crie um projeto grátis em https://supabase.com -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
# Settings -> API -> service_role (NUNCA exponha no frontend, só é usada nas rotas de servidor)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ---- Mercado Pago ----
# Crie uma aplicação em https://www.mercadopago.com.br/developers/panel
# Use as credenciais de TESTE enquanto desenvolve, e as de PRODUÇÃO só quando for cobrar de verdade.
MERCADOPAGO_ACCESS_TOKEN=seu-access-token
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=sua-public-key
# Segredo de assinatura do webhook (Mercado Pago -> Webhooks -> Assinatura secreta)
MERCADOPAGO_WEBHOOK_SECRET=seu-webhook-secret

# ---- App ----
# URL pública onde o site vai rodar (usada nos back_urls do Mercado Pago e no webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Anúncios (Google AdSense) ----
# Preencha só depois de ter uma conta AdSense aprovada para o seu domínio.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_LEFT=
NEXT_PUBLIC_ADSENSE_SLOT_RIGHT=
